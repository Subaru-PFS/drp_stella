from typing import overload

import numpy as np
from lsst.geom import Box2D, Point2D

import pfs.datamodel

from .Distortion import Distortion

class BSpline2D:
    @overload
    def __init__(self, order: int = 3) -> None: ...
    @overload
    def __init__(self, order: int, xKnots: np.ndarray, yKnots: np.ndarray, coeff: np.ndarray) -> None: ...
    def copy(self) -> BSpline2D: ...
    def getOrder(self) -> int: ...
    def getXKnots(self) -> np.ndarray: ...
    def getYKnots(self) -> np.ndarray: ...
    def getCoefficients(self) -> np.ndarray: ...
    def isEmpty(self) -> bool: ...
    def getNumParameters(self) -> int: ...
    def getRange(self) -> Box2D: ...
    @overload
    def __call__(self, x: float, y: float) -> float: ...
    @overload
    def __call__(self, xy: Point2D) -> float: ...
    @overload
    def __call__(self, x: np.ndarray, y: np.ndarray) -> np.ndarray: ...
    @classmethod
    def fromDatamodel(cls, spline: pfs.datamodel.BSpline2D) -> BSpline2D: ...
    def toDatamodel(self) -> pfs.datamodel.BSpline2D: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class BSplineDistortion(Distortion):
    def __init__(
        self, xBoundaries: np.ndarray, xSplines: list[BSpline2D], ySplines: list[BSpline2D]
    ) -> None: ...
    def getNumParameters(self) -> int: ...
    def evaluate(self, xy: Point2D) -> Point2D: ...
    def getXBoundaries(self) -> np.ndarray: ...
    def getXSplines(self) -> list[BSpline2D]: ...
    def getYSplines(self) -> list[BSpline2D]: ...
    def getNumRegions(self) -> int: ...
    def getRegion(self, x: float) -> int: ...
    @classmethod
    def fromDatamodel(cls, distortion: pfs.datamodel.BSplineDistortion) -> BSplineDistortion: ...
    def toDatamodel(self) -> pfs.datamodel.BSplineDistortion: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
