# Bash completion for the "pipetask" command (lsst.ctrl.mpexec.cli.pipetask).
#
# Like "butler", "pipetask" is a Click application (via the same
# lsst.daf.butler.cli.butler.LoaderCLI plugin machinery), so this uses
# Click's built-in completion protocol rather than a static subcommand
# list: on each TAB, it re-invokes the actual "pipetask" executable with
# _PIPETASK_COMPLETE=bash_complete, so completions always match whatever
# is currently set up.
#
# This lives in the "completions" layout that bash-completion (v2, >= 4.1)
# loads on demand: it is only sourced the first time you actually try to
# complete "pipetask ...", so it works regardless of whether "pipetask" is
# on PATH yet at shell startup. See ups/drp_stella.table, which adds this
# directory's parent to BASH_COMPLETION_USER_DIR.

_pipetask_completion() {
    local IFS=$'\n'
    local response

    # Note: invoke via the "VAR=val cmd" builtin form, not the external
    # `env` binary -- on macOS, going through /usr/bin/env strips
    # DYLD_LIBRARY_PATH from the child process (SIP), which breaks
    # dlopen() of the stack's compiled libraries (e.g. libsphgeom).
    response=$(COMP_WORDS="${COMP_WORDS[*]}" COMP_CWORD=$COMP_CWORD _PIPETASK_COMPLETE=bash_complete "$1")

    for completion in $response; do
        IFS=',' read -r type value <<< "$completion"

        if [[ $type == 'dir' ]]; then
            COMPREPLY=()
            compopt -o dirnames
        elif [[ $type == 'file' ]]; then
            COMPREPLY=()
            compopt -o default
        elif [[ $type == 'plain' ]]; then
            COMPREPLY+=("$value")
        fi
    done

    return 0
}

# "-o nosort" needs bash >= 4.4, one version newer than bash-completion's
# own minimum of 4.1; fall back gracefully rather than erroring out.
complete -o nosort -F _pipetask_completion pipetask 2> /dev/null \
    || complete -F _pipetask_completion pipetask
